# Flask config
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///chamada_sus.db

# e-SUS Integration
ESUS_API_URL=https://api.esus.gov.br
ESUS_API_KEY=your-esus-api-key
ESUS_API_TIMEOUT=3

# WebSocket
SOCKETIO_MESSAGE_QUEUE=

# Audio settings
AUDIO_ENABLED=true
